# Supabase (auto-provisioned — do not change)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# KCB BUNI M-Pesa Express — STK Push
# Credentials are stored in the database (kcb_settings table) and configured
# via Settings > Payments in the app. These env vars are optional fallbacks
# used by the edge function when database settings are unavailable.

# Frontend (Vite) fallback values
VITE_KCB_CLIENT_ID=
VITE_KCB_CLIENT_SECRET=
VITE_KCB_BASE_URL=
VITE_KCB_TOKEN_URL=
VITE_KCB_CALLBACK_URL=

# Edge function fallback values (server-side)
KCB_BUNI_CLIENT_ID=
KCB_BUNI_CLIENT_SECRET=
KCB_BUNI_BASE_URL=
KCB_BUNI_TOKEN_URL=
KCB_BUNI_CALLBACK_URL=
DEFAULT_ORG_REF=
