# KCB BUNI environment variables
KCB_BUNI_BASE_URL=https://kcb-buni-api.example.com
KCB_BUNI_TOKEN_URL=https://kcb-buni-api.example.com/oauth/token
KCB_BUNI_CLIENT_ID=your_kcb_buni_client_id
KCB_BUNI_CLIENT_SECRET=your_kcb_buni_client_secret
KCB_BUNI_SHORT_CODE=optional_shared_shortcode_or_empty
KCB_BUNI_CALLBACK_URL=https://production-domain/api/kcb-buni/mpesa/callback
KCB_BUNI_TIMEOUT=10000

# Database
DATABASE_URL=postgresql://user:password@host:5432/dbname?schema=public
