      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// TokenRequest → Tests",
              "// Parses the token response and saves access_token, token_type and expiry to environment vars.",
              "//\n// Expected token response shapes supported:",
              "// { access_token, token_type, expires_in }",
              "// { accessToken, tokenType, expiresIn }",
              "// or nested under data: { data: { access_token: ... } }",
              "",
              "try {",
              "  const json = pm.response.json();",
              "  const token = json.access_token || json.accessToken || json.token || (json.data && (json.data.access_token || json.data.accessToken));",
              "  if (!token) {",
              "    pm.test(\"No access token found in response\", function () {",
              "      pm.expect.fail(\"No access token field present in response JSON\");",
              "    });",
              "  } else {",
              "    pm.environment.set(\"access_token\", token);",
              "    pm.environment.set(\"token_type\", json.token_type || json.tokenType || \"Bearer\");",
              "    const expires = json.expires_in || json.expiresIn;",
              "    if (expires) {",
              "      const expiresAt = Date.now() + (expires * 1000);",
              "      pm.environment.set(\"access_token_expires_at\", expiresAt.toString());",
              "    } else {",
              "      // remove any old expiry if none returned",
              "      pm.environment.unset(\"access_token_expires_at\");",
              "    }",
              "    pm.test(\"Access token saved to environment\", function () {",
              "      pm.expect(pm.environment.get(\"access_token\")).to.not.be.undefined;",
              "    });",
              "  }",
              "} catch (err) {",
              "  pm.test(\"Token parse error\", function () {",
              "    pm.expect.fail(\"Error parsing token response: \" + err.message);",
              "  });",
              "}"
            ]
          }
        }
      ],
      "response": []
    },
